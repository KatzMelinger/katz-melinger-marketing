# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — your secrets stay on your machine.

# --- CallRail -------------------------------------------------------------
# Get from: https://app.callrail.com/account/api-keys
CALLRAIL_API_KEY=
# Get from: top of any URL in CallRail when you're in your account, e.g.
# https://app.callrail.com/account/123456789/...  →  CALLRAIL_ACCOUNT_ID=123456789
CALLRAIL_ACCOUNT_ID=

# --- Anthropic (sales coach + content drafting) ---------------------------
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model used by the sales coach
# SALES_COACH_MODEL=claude-sonnet-4-20250514

# --- Supabase --------------------------------------------------------------
# From: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WARNING: service-role key bypasses RLS. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (analytics, search console) — only needed for those features ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GA4_PROPERTY_ID=

# --- Constant Contact (email) — only needed for /email page ---------------
# CONSTANT_CONTACT_API_KEY=
# CONSTANT_CONTACT_API_SECRET=

# --- Semrush (SEO) — only needed for /seo page ----------------------------
# SEMRUSH_API_KEY=

# --- Ayrshare (social publishing) — only needed to publish/schedule posts --
# Account API key from the Ayrshare dashboard → API Key.
# AYRSHARE_API_KEY=

# New York OpenLegislation API — free key from legislation.nysenate.gov.
# Required for the legal-accuracy layer to verify NY statutory citations
# (NYLL, NYSHRL, CPLR). Without it every NY citation is routed to an attorney
# rather than checked, which is safe but does nothing.
#
# The public nysenate.gov pages are NOT a substitute: they answer a browser but
# 403 server-side fetches regardless of headers, so the API is the only route.
NY_LEGISLATION_API_KEY=
